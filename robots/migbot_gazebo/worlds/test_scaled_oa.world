              <number>3</number>
              <scale>2.5</scale>
              <gain>0.0001</gain>
              <angle>3.14</angle>
              <tau>2.0</tau>
              <amplitude>0.0</amplitude>
              <steepness>0.0</steepness>
            </wave>
          </plugin>
          <geometry>
            <mesh>
              <scale>2.5 2.5 1</scale>
              <uri>model://ocean_waves/meshes/mesh.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>model://ocean_waves/materials/scripts/waves.material</uri>
              <name>WaveSim/GerstnerWaves</name>
            </script>
          </material>
