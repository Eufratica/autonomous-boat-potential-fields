          <plugin name='ocean_waves_visual_plugin' filename='libWavefieldVisualPlugin.so'>
            <enableRtt>1</enableRtt>
            <rttNoise>0.1</rttNoise>
            <refractOpacity>0.2</refractOpacity>
            <reflectOpacity>0.2</reflectOpacity>
