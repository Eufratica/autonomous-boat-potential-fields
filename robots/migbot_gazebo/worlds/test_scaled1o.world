<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <include>
      <pose>0 0 0 0 0 4</pose>    
      <uri>model://ocean_waves</uri>
    </include>  
     

    <include>
      <pose>0 0 0 0 0 0</pose>        
      <uri>model://migbot2_scaled</uri>
    </include>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-8.793253</latitude_deg>
      <longitude_deg>-63.956410</longitude_deg>
      <elevation>90</elevation>
    </spherical_coordinates>
    
    <include>
      <pose>5 0 0 0 0 1.57</pose>    
      <uri>model://trunk1_static</uri>
    </include>         

    <plugin filename="libgazebo_wind_plugin.so" name="wind_plugin">

      <frameId>migbot2::base_link</frameId>
      <robotNamespace/>
      <windVelocityMean>1.0</windVelocityMean>
      <windVelocityMax>20.0</windVelocityMax>
      <windVelocityVariance>0</windVelocityVariance>
      <windDirectionMean>0 1 0</windDirectionMean>
      <windDirectionVariance>0</windDirectionVariance>
      <windGustStart>10</windGustStart>
      <windGustDuration>0</windGustDuration>
      <windGustVelocityMean>0</windGustVelocityMean>
      <windGustVelocityMax>20.0</windGustVelocityMax>
      <windGustVelocityVariance>0</windGustVelocityVariance>
      <windGustDirectionMean>1 0 0</windGustDirectionMean>
      <windGustDirectionVariance>0</windGustDirectionVariance>
      <windPubTopic>world_wind</windPubTopic>
    </plugin>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-20 -0.4 4 0 0.16 -0.087801</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
