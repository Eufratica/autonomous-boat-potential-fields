    </visual>
  </link>
  <link name="Helice_3">
    <inertial>
      <mass value="0.024"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.46e-06" ixy="0" ixz="0" iyy="0.0002307" iyz="0" izz="0.00022938"/>
    </inertial>
    <collision name="Helice_3_colision_collision">
