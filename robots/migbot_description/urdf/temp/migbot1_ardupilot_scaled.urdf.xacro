    <visual name="Helice_4_visual">
      <origin xyz="0 0 0" rpy="1.57075 0      1.57075"/>
      <geometry>
        <mesh filename="package://migbot_description/urdf/meshes_scaled/helice_fundo.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <link name="Helice_5">
    <inertial>
      <mass value="0.024"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.46e-06" ixy="0" ixz="0" iyy="0.0002307" iyz="0" izz="0.00022938"/>
    </inertial>
    <collision name="Helice_2_colision_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.001"/>
