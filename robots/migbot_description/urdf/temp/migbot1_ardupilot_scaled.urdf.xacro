  </link> -->
  
  
  <link name="base_link">
    <inertial>
      <mass value="4.50244"/>
      <origin xyz="-0.15   0   0.2" rpy="0 0 0"/>
      <inertia ixx="0.51" ixy="0.51" ixz="0.13" iyy="1.14" iyz="0.07" izz="0.31"/>
    </inertial>
    <collision name="base_link_collision">
      <origin xyz="0 0 0" rpy="0   0   3.14"/>
      <geometry>
        <mesh filename="package://migbot_description/urdf/meshes_scaled/Barco.dae" scale="1 1 1"/>
      </geometry>
    </collision>
    <visual name="base_link_visual">
      <origin xyz="0 0 0" rpy="0   0   3.14"/>
      <geometry>
        <mesh filename="package://migbot_description/urdf/meshes_scaled/Barco.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <link name="Helice_1">
    <inertial>
      <mass value="0.024"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.46e-06" ixy="0" ixz="0" iyy="0.0002307" iyz="0" izz="0.00022938"/>
    </inertial>
    <collision name="Helice_1_colision_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.001"/>
      </geometry>
    </collision>
    <visual name="Helice_1_visual">
      <origin xyz="0 0 0" rpy="1.57075 0      1.57075"/>
      <geometry>
        <mesh filename="package://migbot_description/urdf/meshes_scaled/helice_frente.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <link name="Helice_2">
    <inertial>
      <mass value="0.024"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1.46e-06" ixy="0" ixz="0" iyy="0.0002307" iyz="0" izz="0.00022938"/>
    </inertial>
    <collision name="Helice_2_colision_collision">
