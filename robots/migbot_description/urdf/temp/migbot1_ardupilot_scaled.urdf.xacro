<?xml version="1.0" ?>
<robot name="migbot1_scaled">
  <joint name="Engine_helice_1" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_1"/>
    <origin xyz="0.27  -0.26  0.37" rpy="0      1.57075 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint>
  <joint name="Engine_helice_2" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_2"/>
    <origin xyz="-0.19 0.26 0.35" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint>
  <joint name="Engine_helice_3" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_3"/>
    <origin xyz="0.27 0.26 0.37" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint>
  <joint name="Engine_helice_4" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_4"/>
    <origin xyz="-0.19 -0.26 0.35" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint>
  <joint name="Engine_helice_5" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_5"/>
    <origin xyz="-0.29 0.26 0.35" rpy="0 1.5708 -3.14"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint> 
  <joint name="Engine_helice_6" type="revolute">
    <parent link="base_link"/>
    <child link="Helice_6"/>
    <origin xyz="-0.29 -0.26 0.35" rpy="0 1.5708 -3.14"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="-1.79769e+308" upper="1.79769e+308" velocity="100.0"/> <!-- TO ADJUST-->
  </joint>       

<!--
  <joint name="dummy_joint" type="fixed">
