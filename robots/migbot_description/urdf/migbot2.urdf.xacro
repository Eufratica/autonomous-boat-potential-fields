<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="migbot2">
  <xacro:arg name="namespace" default="migbot2"/>
  <xacro:arg name="ardupilot" default="true"/>
  <xacro:property name="imu_mass" value="0.002"/>
  <xacro:property name="mag_mass" value="0.001"/>
  <xacro:property name="fluid_density" value="1025.0"/>
  <xacro:property name="fluid_level" value="0.0001"/>
  <xacro:property name="hull_radius" value="10.6"/>
  <xacro:property name="boat_width" value="1.848"/>
  <xacro:property name="boat_length" value="2.3"/>
  <xacro:property name="wave_model" value="0"/>
  <xacro:property name="ref_lat" value="-8.798638"/>
  <xacro:property name="ref_lon" value="-63.952087"/>
  <xacro:property name="ref_alt" value="58"/>
  <xacro:property name="S" value="1.0"/>
  <link name="Helice_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
