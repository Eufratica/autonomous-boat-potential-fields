      <origin xyz="1.5002675354480743e-05 -4.023313522338867e-07 1.825392246246338e-07" rpy="0 0 0"/>
      <mass value="0.190030"/>
      <inertia ixx="0.009499" ixy="0.0" ixz="0.0" iyy="0.000149" iyz="0.0" izz="0.009499"/>
    </inertial>
  </link>
