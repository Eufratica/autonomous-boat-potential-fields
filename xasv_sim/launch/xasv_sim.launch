<launch>

<arg name="world_name" default="empty_river.world"/>  

  
  <!-- Gazebo world -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find xasv_sim)/worlds/$(arg world_name).world"/>
    <arg name="verbose" value="true"/>
    <arg name="paused" value="false"/>
    <arg name="gui" value="true"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <!-- Namespace do robô -->
  <arg name="namespace" default="$(arg robot_name)"/>
  <arg name="robot_name" default="$(arg robot_name)"/>

  <!-- Modo de controle -->
  <arg name="ardupilot" default="true"/>  <!-- true = ArduPilot, false = ROS controllers -->

  <!-- Pose inicial -->
  <arg name="x" default="1095.546631"/>
  <arg name="y" default="-379.051544"/>
  <arg name="z" default="0.5"/>
  <arg name="P" default="0"/>
  <arg name="R" default="0"/>
  <arg name="Y" default="3.14"/>

  <!-- Flags de sensores (se seu xacro usa) -->
  <arg name="camera_enabled" default="false"/>
  <arg name="ground_truth_enabled" default="false"/>
  <arg name="livox_enabled" default="false"/>
  <arg name="ping360_enabled" default="false"/>
  <arg name="imaging" default="false"/>

  <!-- URDF/Xacro -->
  <arg name="urdf" default="$(find migbot_gazebo)/urdf/migbot_gazebo.urdf.xacro"/>

  <!-- TUDO no mesmo namespace -->
  <group ns="$(arg namespace)">

    <!-- /<ns>/robot_description  (passa ardupilot para o xacro) -->
    <param name="robot_description"
           command="$(find xacro)/xacro $(arg urdf)
                    namespace:=$(arg namespace)
                    robot_name:=$(arg robot_name)
                    ardupilot:=$(arg ardupilot)
                    imaging:=$(arg imaging)
                    livox_enabled:=$(arg livox_enabled)
                    ping360_enabled:=$(arg ping360_enabled)
                    camera_enabled:=$(arg camera_enabled)
                    ground_truth_enabled:=$(arg ground_truth_enabled)"/>

    <!-- Spawn no Gazebo lendo esse param -->
    <node name="spawn_model" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-x $(arg x) -y $(arg y) -z $(arg z) -R $(arg R) -P $(arg P) -Y $(arg Y)
                -urdf -param robot_description
                -model $(arg robot_name)
                -robot_namespace $(arg namespace)"/>

    <!-- TFs estáticos (se precisar) -->
    <node pkg="tf" type="static_transform_publisher" name="livox_tf"
          args="-0.37 0.0 -0.3 0 0 0 base_link livox 100"/>
    <node pkg="tf" type="static_transform_publisher" name="ping_tf"
          args="0 0 -20 0 0 0 base_link sonar_frame 100"/>

    <!-- Sempre útil em ambos os modos -->
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

    <!-- ===== CONTROLE VIA ROS (apenas quando ardupilot=false) ===== -->
    <group unless="$(arg ardupilot)">

      <!-- Controllers -->
      <rosparam>
joint_state_controller:
  type: joint_state_controller/JointStateController
  publish_rate: 50

Engine_helice_1_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_1

Engine_helice_2_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_2

Engine_helice_3_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_3

Engine_helice_4_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_4

Engine_helice_5_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_5

Engine_helice_6_effort_controller:
  type: effort_controllers/JointEffortController
  joint: Engine_helice_6
      </rosparam>

      <!-- Spawner dos controllers acima -->
      <node name="controller_spawner" pkg="controller_manager" type="spawner" output="screen" respawn="true"
            args="joint_state_controller
                  Engine_helice_1_effort_controller Engine_helice_2_effort_controller
                  Engine_helice_3_effort_controller Engine_helice_4_effort_controller
                  Engine_helice_5_effort_controller Engine_helice_6_effort_controller"/>
    </group>

    <!-- ===== CONTROLE VIA ARDUPILOT (apenas quando ardupilot=true) ===== -->
    <group if="$(arg ardupilot)">
      <!-- Se seu XACRO já carrega o ArduPilotPlugin via <xacro:if>, não precisa nada aqui.
           Caso queira iniciar SITL/bridge por aqui, deixe seus nós/remaps neste bloco. -->

      <!-- Exemplo: relay opcional para ver o comando chegando (apague se não quiser)
      <node pkg="topic_tools" type="relay" name="relay_motor_cmd"
            args="/gazebo/command/motor_speed /motor_cmd_debug"/>
      -->
    </group>

  </group>
</launch>

