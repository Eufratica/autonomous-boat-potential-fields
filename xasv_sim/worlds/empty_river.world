<?xml version="1.0" ?>

<sdf version="1.6">
  <world name="calm">
    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <grid>0</grid>
      <origin_visual>0</origin_visual>
    </scene>
    <!-- Estimated latitude/longitude of madeira river
	 from satellite imagery -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-8.793253</latitude_deg>
      <longitude_deg>-63.956410</longitude_deg>
      <elevation>90.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://ocean_waves</uri>
    </include>
    
     
    
    
    
    
    
  </world>
</sdf>
