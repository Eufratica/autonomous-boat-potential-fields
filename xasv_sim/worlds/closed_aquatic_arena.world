<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="closed_aquatic_arena">
    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <grid>0</grid>
      <origin_visual>0</origin_visual>
    </scene>

    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Water Surface -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://ocean_waves</uri>
    </include>

    <!-- ==================== ARENA PERIMETER (CLOSED BOUNDARY 60m x 40m) ==================== -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>30 20 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>62 0.8 1.5</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>62 0.8 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>30 -20 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>62 0.8 1.5</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>62 0.8 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>60 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 40.8 1.5</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 40.8 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 40.8 1.5</size></box></geometry>
          <material><script><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 40.8 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== STATIC OBSTACLES (BUOYS ON WATER) ==================== -->
